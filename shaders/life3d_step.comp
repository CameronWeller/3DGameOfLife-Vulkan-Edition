#version 450
#extension GL_GOOGLE_include_directive : require

// One generation over a range of active chunks (see life3d_storage.glsl). Each
// invocation computes a row of 32 cells with bit-sliced arithmetic
// (life3d_bits.glsl); a workgroup covers a 32 x 8 slab of rows in one chunk.
// Missing neighbor chunks count as dead space. Drawing and chunk bookkeeping
// happen in life3d_build.comp after the last generation of a batch.

layout(local_size_x = 32, local_size_y = 8, local_size_z = 1) in; // CHUNK x SLAB_DEPTH

#include "life3d_storage.glsl"
#include "life3d_bits.glsl"

layout(push_constant) uniform Params {
    uint firstIndex;  // first entry of the active list in this dispatch
    uint count;       // entries in this dispatch
    uint surviveMask; // bit n: a live cell with n live neighbors survives
    uint birthMask;   // bit n: an empty cell with n live neighbors is born
} params;

layout(std430, binding = 0) readonly buffer Current { uint rows[]; } current;
layout(std430, binding = 1) writeonly buffer Next { uint rows[]; } next;

// The live-neighbor rows (life and Ember) of the tile around this slab. Each
// row is kept three ways: as is, and shifted so bit i holds the cell at x - 1
// (west) or x + 1 (east), with the edge bit taken from the chunk next door.
shared uint tileWest[TILE];
shared uint tileRow[TILE];
shared uint tileEast[TILE];

// Live cells and Embers of `row` in neighbor chunk k.
uint liveRow(uint k, uint row) {
    uint chunk = nearChunk[k];
    if (chunk == NO_CHUNK) return 0u;
    return current.rows[chunk * ROWS + row] | blockRow(k, row, 1u);
}

void main() {
    if (gl_WorkGroupID.y >= params.count) return; // uniform across the workgroup
    uint slot = activeList.slots[params.firstIndex + gl_WorkGroupID.y];
    loadNeighborhood(slot);

    // 1. Copy the tile into shared memory, WORKGROUP_SIZE rows at a time.
    int z0 = int(gl_WorkGroupID.x * SLAB_DEPTH);
    for (uint entry = gl_LocalInvocationIndex; entry < TILE; entry += WORKGROUP_SIZE) {
        int y;
        int z;
        tilePosition(entry, z0, y, z);
        uint k;
        uint row = rowAndNeighbor(y, z, 0, k);
        uint center = liveRow(k, row);
        tileRow[entry] = center;
        tileWest[entry] = (center << 1) | (liveRow(k - 1u, row) >> 31); // k - 1: the chunk at -x
        tileEast[entry] = (center >> 1) | (liveRow(k + 1u, row) << 31); // k + 1: the chunk at +x
    }
    barrier();

    // 2. Gather this row's 27 neighbor rows from the tile, in the order
    //    countNeighbors() expects, and compute the next generation.
    uint y = gl_LocalInvocationID.x;
    uint z = uint(z0) + gl_LocalInvocationID.y;
    uint nb[27];
    for (uint dz = 0u; dz < 3u; dz++) {
        for (uint dy = 0u; dy < 3u; dy++) {
            uint entry = (gl_LocalInvocationID.y + dz) * TILE_Y + (y + dy);
            uint k = dz * 9u + dy * 3u;
            nb[k] = tileWest[entry];
            nb[k + 1u] = tileRow[entry];
            nb[k + 2u] = tileEast[entry];
        }
    }
    uint row = z * CHUNK + y;
    uint index = slot * ROWS + row;
    uint blocked = blockRow(SELF, row, 0u);
    next.rows[index] = nextRow(nb, current.rows[index], blocked, params.surviveMask, params.birthMask);
}
