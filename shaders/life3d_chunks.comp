#version 450

// One pass over the active chunks of a sparse, unbounded 3D life world.
// Each chunk is 16^3 cells stored at slot * 4096 in the cell pool. A missing
// neighbor chunk counts as dead space. Besides the next generation, every pass
// appends live cells to the instance list drawn by life3d_world.vert and records
// per-chunk population plus which neighbor chunks live border cells touch, so
// the CPU can grow and shrink the chunk set.

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

const uint CHUNK = 16u;
const uint CHUNK_CELLS = 4096u;
const uint NO_CHUNK = 0xFFFFFFFFu;

layout(push_constant) uniform Params {
    uint activeCount;
    uint surviveMask;  // bit n: a live cell with n live neighbors survives
    uint birthMask;    // bit n: a dead cell with n live neighbors is born
    uint applyRule;    // 1 = advance a generation, 0 = only rebuild instances and stats
    uint maxInstances;
} params;

layout(std430, binding = 0) readonly buffer Current { uint cells[]; } current;
layout(std430, binding = 1) writeonly buffer Next { uint cells[]; } next;
// 27 slots per chunk for offsets (dx,dy,dz) in [-1,1]^3, index (dz+1)*9+(dy+1)*3+(dx+1).
layout(std430, binding = 2) readonly buffer Neighbors { uint slots[]; } neighbors;
layout(std430, binding = 3) readonly buffer ActiveList { uint slots[]; } activeList;
layout(std430, binding = 4) readonly buffer Origins { ivec4 cell[]; } origins; // world cell of local (0,0,0)
layout(std430, binding = 5) buffer Stats { uvec2 values[]; } stats;           // x population, y border mask
layout(std430, binding = 6) writeonly buffer Instances { ivec4 cells[]; } instances;
layout(std430, binding = 7) buffer Indirect {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
} indirect;

shared uint groupAlive;
shared uint groupBorders;
shared uint groupBase;

uint localIndex(uvec3 p) {
    return (p.z * CHUNK + p.y) * CHUNK + p.x;
}

uint cellAt(uint slot, ivec3 p) {
    ivec3 chunkOffset = (p + int(CHUNK)) / int(CHUNK) - 1; // p is in [-1, 16]
    uint index = uint((chunkOffset.z + 1) * 9 + (chunkOffset.y + 1) * 3 + (chunkOffset.x + 1));
    uint neighbor = neighbors.slots[slot * 27u + index];
    if (neighbor == NO_CHUNK) return 0u;
    return current.cells[neighbor * CHUNK_CELLS + localIndex(uvec3(p - chunkOffset * int(CHUNK)))];
}

// Neighbor chunk directions a live cell at `local` can cause births in.
uint borderMask(uvec3 local) {
    uint mask = 0u;
    for (int dz = -1; dz <= 1; dz++) {
        if (dz == -1 && local.z != 0u || dz == 1 && local.z != CHUNK - 1u) continue;
        for (int dy = -1; dy <= 1; dy++) {
            if (dy == -1 && local.y != 0u || dy == 1 && local.y != CHUNK - 1u) continue;
            for (int dx = -1; dx <= 1; dx++) {
                if (dx == -1 && local.x != 0u || dx == 1 && local.x != CHUNK - 1u) continue;
                if (dx != 0 || dy != 0 || dz != 0) mask |= 1u << uint((dz + 1) * 9 + (dy + 1) * 3 + (dx + 1));
            }
        }
    }
    return mask;
}

void main() {
    // Every invocation of a workgroup shares the same chunk, so this exit is uniform.
    uint listIndex = gl_WorkGroupID.z / 4u;
    if (listIndex >= params.activeCount) return;

    uint slot = activeList.slots[listIndex];
    uvec3 local = uvec3(gl_WorkGroupID.xy * 4u + gl_LocalInvocationID.xy,
                        (gl_WorkGroupID.z % 4u) * 4u + gl_LocalInvocationID.z);
    uint index = slot * CHUNK_CELLS + localIndex(local);
    uint alive = current.cells[index];

    if (params.applyRule != 0u) {
        uint count = 0u;
        for (int dz = -1; dz <= 1; dz++)
            for (int dy = -1; dy <= 1; dy++)
                for (int dx = -1; dx <= 1; dx++)
                    if (dx != 0 || dy != 0 || dz != 0) count += cellAt(slot, ivec3(local) + ivec3(dx, dy, dz));
        uint mask = alive != 0u ? params.surviveMask : params.birthMask;
        alive = (mask >> count) & 1u;
        next.cells[index] = alive;
    }

    if (gl_LocalInvocationIndex == 0u) {
        groupAlive = 0u;
        groupBorders = 0u;
    }
    barrier();

    uint offset = 0u;
    if (alive != 0u) {
        offset = atomicAdd(groupAlive, 1u);
        uint borders = borderMask(local);
        if (borders != 0u) atomicOr(groupBorders, borders);
    }
    barrier();

    if (gl_LocalInvocationIndex == 0u && groupAlive > 0u) {
        atomicAdd(stats.values[slot].x, groupAlive);
        if (groupBorders != 0u) atomicOr(stats.values[slot].y, groupBorders);
        groupBase = atomicAdd(indirect.instanceCount, groupAlive);
    }
    barrier();

    if (alive != 0u) {
        uint instance = groupBase + offset;
        if (instance < params.maxInstances) {
            instances.cells[instance] = ivec4(origins.cell[slot].xyz + ivec3(local), 0);
        }
    }
}
