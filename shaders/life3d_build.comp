#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_ballot : require

// Runs after the last generation of a batch (and after edits). For every active
// chunk it
//   - counts the live cells (stats.x) and flags which neighbor chunks live cells
//     or Ember blocks within `margin` cells of a face could reach (stats.y), so
//     the CPU can add and free chunks and then run up to `margin` generations
//     before it needs to look again;
//   - appends one instance per visible block (a block with at least one face not
//     covered by a neighbor) for life3d_blocks.vert, with its 26 neighbors for
//     face culling and ambient occlusion. With BUILD_ANIMATE, cells that died in
//     the last generation are drawn too, so they can shrink away.

layout(local_size_x = 32, local_size_y = 8, local_size_z = 1) in; // CHUNK x SLAB_DEPTH

#include "life3d_storage.glsl"
#include "life3d_instances.glsl"

// Must match BuildConstants in src/world/SimulationPasses.cpp.
layout(push_constant) uniform Params {
    mat4 cullViewProjection; // a slightly wider view than the camera's: chunks outside it are not drawn
    uint firstIndex;         // first entry of the active list in this dispatch
    uint count;              // entries in this dispatch
    uint margin;             // cells from a face that count as reaching the neighbor chunk
    uint flags;              // BUILD_* bits
    uint maxInstances;       // room in the instance buffer
    float cullDistance;      // chunks farther than this from the camera are not drawn
    float cameraX, cameraY, cameraZ;
} params;
const uint BUILD_ANIMATE = 1u; // flag births, draw the last deaths
const uint BUILD_DRAW = 2u;    // write the block list
const uint BUILD_STATS = 4u;   // count population and reach

layout(std430, binding = 0) readonly buffer Current { uint rows[]; } current;
layout(std430, binding = 1) readonly buffer Previous { uint rows[]; } previous; // the generation before
layout(std430, binding = 6) buffer Stats { uvec2 values[]; } stats; // x population, y reach mask
layout(std430, binding = 7) writeonly buffer Instances { uvec2 cells[]; } instances;
layout(std430, binding = 8) buffer Indirect { // VkDrawIndexedIndirectCommand
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
} indirect;
layout(std430, binding = 9) readonly buffer Origins { ivec4 cell[]; } origins; // world cell of local (0, 0, 0)

// Occupied rows (life or any block) of the tile around the slab, and "stable"
// rows: cells occupied in both this and the previous generation. Faces are
// culled only against stable neighbors, so a neighbor that is growing in or
// shrinking away never exposes a hole. West/east are shifted as in
// life3d_step.comp.
shared uint occupiedWest[TILE];
shared uint occupiedRow[TILE];
shared uint occupiedEast[TILE];
shared uint stableWest[TILE];
shared uint stableRow[TILE];
shared uint stableEast[TILE];

// Occupied cells of `row` in neighbor chunk k, now or in the previous generation.
uint occupied(uint k, uint row, bool previousGeneration) {
    uint chunk = nearChunk[k];
    if (chunk == NO_CHUNK) return 0u;
    uint index = chunk * ROWS + row;
    uint life = previousGeneration ? previous.rows[index] : current.rows[index];
    return life | blockRow(k, row, 0u);
}

// False when all eight corners of the chunk lie outside the same side of the
// view, so none of it can be seen. (A chunk can still be invisible when this
// returns true; the test only has to be cheap and never wrong the other way.)
bool chunkInView(vec3 lowCorner) {
    uint outside[6] = uint[6](0u, 0u, 0u, 0u, 0u, 0u); // corners beyond each clip plane
    for (uint i = 0u; i < 8u; i++) {
        vec3 corner = lowCorner + vec3(i & 1u, (i >> 1) & 1u, (i >> 2) & 1u) * float(CHUNK);
        vec4 clip = params.cullViewProjection * vec4(corner, 1.0);
        outside[0] += uint(clip.x < -clip.w);
        outside[1] += uint(clip.x > clip.w);
        outside[2] += uint(clip.y < -clip.w);
        outside[3] += uint(clip.y > clip.w);
        outside[4] += uint(clip.z < 0.0);
        outside[5] += uint(clip.z > clip.w);
    }
    for (uint plane = 0u; plane < 6u; plane++) {
        if (outside[plane] == 8u) return false;
    }
    return true;
}

// The neighbor chunks (bit k, as in the neighbor table) that live cells in this
// row at (y, z) could reach within `margin` generations: those within `margin`
// cells of the face, edge or corner they share.
uint reachMask(uint live, uint y, uint z) {
    if (live == 0u) return 0u;
    uint margin = params.margin;
    uint lowCells = (1u << margin) - 1u;           // x < margin
    uint highCells = ~(0xFFFFFFFFu >> margin);     // x >= CHUNK - margin
    // For each axis: near the low face, anywhere (the same chunk), near the high face.
    bool nearX[3] = bool[3]((live & lowCells) != 0u, true, (live & highCells) != 0u);
    bool nearY[3] = bool[3](y < margin, true, y >= CHUNK - margin);
    bool nearZ[3] = bool[3](z < margin, true, z >= CHUNK - margin);
    uint mask = 0u;
    for (uint dz = 0u; dz < 3u; dz++) {
        for (uint dy = 0u; dy < 3u; dy++) {
            for (uint dx = 0u; dx < 3u; dx++) {
                if (nearX[dx] && nearY[dy] && nearZ[dz]) mask |= 1u << (dz * 9u + dy * 3u + dx);
            }
        }
    }
    return mask & ~(1u << SELF); // the chunk itself always exists
}

void main() {
    if (gl_WorkGroupID.y >= params.count) return; // uniform across the workgroup
    uint slot = activeList.slots[params.firstIndex + gl_WorkGroupID.y];

    // Whole chunks out of view skip the drawing work; a pass that only draws
    // (after a camera move) skips them entirely. Uniform across the workgroup.
    ivec3 origin = origins.cell[slot].xyz;
    vec3 camera = vec3(params.cameraX, params.cameraY, params.cameraZ);
    vec3 nearest = clamp(camera, vec3(origin), vec3(origin + int(CHUNK)));
    bool wantDraw = (params.flags & BUILD_DRAW) != 0u && distance(nearest, camera) <= params.cullDistance &&
                    chunkInView(vec3(origin));
    bool wantStats = (params.flags & BUILD_STATS) != 0u;
    if (!wantDraw && !wantStats) return;
    loadNeighborhood(slot);

    // 1. Copy the tile's occupied and stable rows into shared memory (drawing only).
    bool animate = (params.flags & BUILD_ANIMATE) != 0u;
    int z0 = int(gl_WorkGroupID.x * SLAB_DEPTH);
    for (uint entry = gl_LocalInvocationIndex; wantDraw && entry < TILE; entry += WORKGROUP_SIZE) {
        int tileY;
        int tileZ;
        tilePosition(entry, z0, tileY, tileZ);
        uint k;
        uint row = rowAndNeighbor(tileY, tileZ, 0, k);
        uint center = occupied(k, row, false);
        uint westEdge = occupied(k - 1u, row, false) >> 31; // cell 31 of the chunk at -x
        uint eastEdge = occupied(k + 1u, row, false) << 31; // cell 0 of the chunk at +x
        occupiedRow[entry] = center;
        occupiedWest[entry] = (center << 1) | westEdge;
        occupiedEast[entry] = (center >> 1) | eastEdge;
        if (animate) {
            center &= occupied(k, row, true);
            westEdge &= occupied(k - 1u, row, true) >> 31;
            eastEdge &= occupied(k + 1u, row, true) << 31;
        }
        stableRow[entry] = center;
        stableWest[entry] = (center << 1) | westEdge;
        stableEast[entry] = (center >> 1) | eastEdge;
    }
    barrier();

    uint y = gl_LocalInvocationID.x;
    uint z = uint(z0) + gl_LocalInvocationID.y;
    uint row = z * CHUNK + y;
    uint index = slot * ROWS + row;
    uint life = current.rows[index];
    uint blocked = blockRow(SELF, row, 0u);
    uint emits = blockRow(SELF, row, 1u);

    // 2. Population and reach, combined across the subgroup so only one
    //    invocation per subgroup touches the counters.
    if (wantStats) {
        uint population = subgroupAdd(uint(bitCount(life)));
        uint reach = subgroupOr(reachMask(life | emits, y, z));
        if (subgroupElect()) {
            if (population != 0u) atomicAdd(stats.values[slot].x, population);
            if (reach != 0u) atomicOr(stats.values[slot].y, reach);
        }
    }
    if (!wantDraw) return;

    // 3. Visible blocks: occupied cells with a face not covered by a stable
    //    neighbor, plus (when animating) cells that just died.
    uint self = (gl_LocalInvocationID.y + 1u) * TILE_Y + (y + 1u); // this row's tile entry
    uint covered = stableWest[self] & stableEast[self] & stableRow[self - 1u] & stableRow[self + 1u] &
                   stableRow[self - TILE_Y] & stableRow[self + TILE_Y];
    uint draw = occupiedRow[self] & ~covered;
    uint previousLife = 0u;
    if (animate) {
        previousLife = previous.rows[index];
        draw |= previousLife & ~life & ~blocked; // died last generation: shrink away
    }

    // 4. Reserve room in the instance list: one atomic per subgroup, then each
    //    invocation writes at its own offset within the subgroup's range.
    uint blockCount = uint(bitCount(draw));
    uint offsetInSubgroup = subgroupExclusiveAdd(blockCount);
    uint subgroupTotal = subgroupAdd(blockCount);
    uint subgroupBase = 0u;
    if (subgroupElect() && subgroupTotal != 0u) {
        subgroupBase = atomicAdd(indirect.instanceCount, subgroupTotal);
    }
    uint next = subgroupBroadcastFirst(subgroupBase) + offsetInSubgroup;
    if (draw == 0u) return;

    // 5. The 27 rows around this row. Corners and edges use occupied rows (for
    //    ambient occlusion); the six face neighbors use stable rows, matching
    //    the face culling above.
    uint nb[27];
    for (uint dz = 0u; dz < 3u; dz++) {
        for (uint dy = 0u; dy < 3u; dy++) {
            uint entry = self + (dz - 1u) * TILE_Y + (dy - 1u);
            uint k = dz * 9u + dy * 3u;
            nb[k] = occupiedWest[entry];
            nb[k + 1u] = occupiedRow[entry];
            nb[k + 2u] = occupiedEast[entry];
        }
    }
    nb[4] = stableRow[self - TILE_Y]; // -z
    nb[10] = stableRow[self - 1u];    // -y
    nb[12] = stableWest[self];        // -x
    nb[SELF] = 0u;
    nb[14] = stableEast[self];        // +x
    nb[16] = stableRow[self + 1u];    // +y
    nb[22] = stableRow[self + TILE_Y]; // +z

    // 6. One instance per visible block, lowest x first.
    while (draw != 0u) {
        uint x = uint(findLSB(draw));
        draw &= draw - 1u; // clear that bit
        if (next >= params.maxInstances) break; // the list is full: farther blocks are not drawn
        uint neighborBits = 0u;
        for (uint k = 0u; k < 27u; k++) {
            neighborBits |= ((nb[k] >> x) & 1u) << k;
        }
        uint bit = 1u << x;
        uint kind = (emits & bit) != 0u ? KIND_EMBER : ((blocked & bit) != 0u ? KIND_STONE : KIND_LIFE);
        bool born = animate && (life & bit) != 0u && (previousLife & bit) == 0u;
        bool dying = (life & bit) == 0u && (blocked & bit) == 0u;
        instances.cells[next] = packInstance(neighborBits, kind, born, dying, slot, x, y, z);
        next++;
    }
}
